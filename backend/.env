APP_NAME=UniNest API
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173
MONGODB_URL=mongodb://localhost:27017/uninest?replicaSet=rs0
DATABASE_NAME=uninest
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BOOKING_COMMISSION_RATE=0.20
UPLOAD_DIR=uploads
